# Copy to .env on EC2 (never commit .env). Dashboard: https://your-domain/admin
OPENAI_API_KEY=
ADMIN_NUMBER=

# --- Témí WhatsApp bot (Meta Cloud API transport) ---
# Webhook listens on BOT_PORT (default 3001). Meta calls:
#   https://your-domain:3001/webhook
BOT_PORT=3001
# From Meta dashboard → WhatsApp → API Setup (test number is fine to start)
META_PHONE_ID=
META_ACCESS_TOKEN=
# Invent any secret string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Paste the SAME value into Meta dashboard → WhatsApp → Configuration → Webhook → Edit.
META_VERIFY_TOKEN=
# Optional: enables X-Hub-Signature-256 checks on POST /webhook.
# From Meta dashboard → App settings → Basic → App Secret. Leave unset to skip.
META_APP_SECRET=
# Optional (defaults to v22.0)
# META_GRAPH_VERSION=v22.0

# Safety: back up users_db.json + opted_in_users.json on EC2 before cutover.
# Migration won't touch them, but returning users start fresh wa_id records
# while old @c.us/@lid rows go dormant.
PORT=3000
ADMIN_ENABLED=1
ADMIN_USER=admin
# Generate: npm run admin:hash -- "your-strong-password"  → paste output below
ADMIN_PASS_HASH=
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=production
